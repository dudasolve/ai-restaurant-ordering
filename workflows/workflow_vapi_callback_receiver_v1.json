{
  "name": "vapi_callback_receiver_v1",
  "nodes": [
    {
      "id": "webhook-callback-001",
      "name": "Vapi Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-callback-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "callback-webhook-fixed-001"
    },
    {
      "id": "parse-callback-001",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst msg  = body?.message || body;\nconst args = msg?.toolCallList?.[0]?.function?.arguments || {};\nconst toolCallId  = msg?.toolCallList?.[0]?.id || '';\nconst customerNum = msg?.call?.customer?.number || '';\n\nreturn [{ json: {\n  callerName:  args.callerName  || '',\n  callerPhone: args.callerPhone || customerNum,\n  reason:      args.reason      || 'Requested human',\n  toolCallId,\n  timestamp: new Date().toISOString()\n} }];"
      }
    },
    {
      "id": "airtable-callbacks-node-001",
      "name": "Log Callback to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "appmBaUD39bNFM4QA",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "tblWNa0KZhD8FbomB",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Caller Name": "={{ $json.callerName }}",
            "Phone": "={{ $json.callerPhone }}",
            "Notes / Reason": "={{ $json.reason }}",
            "Timestamp": "={{ $json.timestamp }}",
            "Status": "Todo"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "otkgs9oolwSO4bW3",
          "name": "ZosGoodBurger Airtable"
        }
      }
    },
    {
      "id": "respond-callback-001",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        540,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ results: [{ toolCallId: $('Parse Callback').item.json.toolCallId, result: 'Callback logged. A team member will call you back shortly.' }] }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Vapi Callback Webhook": {
      "main": [
        [
          {
            "node": "Parse Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Callback": {
      "main": [
        [
          {
            "node": "Log Callback to Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Callback to Airtable": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}